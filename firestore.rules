rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "jennailstudio23@gmail.com";
    }

    function validReservaCreate() {
      return request.resource.data.keys().hasAll([
        "clienteNombre",
        "clienteTelefono",
        "direccion",
        "barrio",
        "tipoUna",
        "fechaHora",
        "precioTotal",
        "estado"
      ])
      && request.resource.data.clienteNombre is string
      && request.resource.data.clienteTelefono is string
      && request.resource.data.direccion is string
      && request.resource.data.barrio is string
      && request.resource.data.tipoUna is string
      && request.resource.data.precioTotal is number
      && request.resource.data.estado is string;
    }

    function validClienteReservaUpdate() {
      return resource.data.estado in ["Agendado", "En curso"]
      && request.resource.data.estado == resource.data.estado
      && request.resource.data.precioTotal == resource.data.precioTotal
      && request.resource.data.clienteNombre == resource.data.clienteNombre
      && (
        ("clienteTelefono" in resource.data && request.resource.data.clienteTelefono == resource.data.clienteTelefono) ||
        (!("clienteTelefono" in resource.data) && "clineteTelefono" in resource.data && request.resource.data.clineteTelefono == resource.data.clineteTelefono)
      )
      && request.resource.data.direccion is string
      && request.resource.data.barrio is string
      && request.resource.data.tipoUna is string
      && request.resource.data.modeloSeleccionado is string;
    }

    // Flujo actual:
    // - Usuario final sin login: crea y consulta reservas.
    // - Admin autenticado: puede leer/editar todo.
    match /reservas/{reservaId} {
      allow create: if validReservaCreate();
      allow read: if true;
      allow update: if isAdmin() || validClienteReservaUpdate();
      allow delete: if isAdmin();
    }

    match /modelos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /servicios/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clientes/{docId} {
      allow read, write: if isAdmin();
    }

    match /fidelizacion/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
